{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "relationships table",
  "type": "object",
  "required": [
    "release",
    "table",
    "records"
  ],
  "properties": {
    "release": {
      "$ref": "#/$defs/release"
    },
    "table": {
      "const": "relationships"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "release": {
      "type": "object",
      "required": [
        "schemaVersion",
        "releaseId",
        "status",
        "preparedOn",
        "publishedAt",
        "dataRevision"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "releaseId": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "local-candidate",
            "published"
          ]
        },
        "preparedOn": {
          "type": "string",
          "format": "date"
        },
        "publishedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "dataRevision": {
          "type": "integer"
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": [
        "type",
        "identity"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "unknown"
          ]
        },
        "identity": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "claimReview": {
      "type": "object",
      "required": [
        "status",
        "reviewedAt",
        "reviewer"
      ],
      "properties": {
        "status": {
          "enum": [
            "legacy-unrecorded",
            "reviewed"
          ]
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer": {
          "$ref": "#/$defs/reviewer"
        }
      }
    },
    "validity": {
      "type": "object",
      "required": [
        "start",
        "end",
        "startPrecision",
        "endPrecision",
        "certainty"
      ],
      "properties": {
        "start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "startPrecision": {
          "enum": [
            "day",
            "month",
            "year",
            "period",
            "unknown"
          ]
        },
        "endPrecision": {
          "enum": [
            "day",
            "month",
            "year",
            "period",
            "unknown"
          ]
        },
        "certainty": {
          "enum": [
            "documented",
            "uncertain",
            "unknown"
          ]
        },
        "sourceIds": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "role",
        "sourceIds",
        "externalIdentifiers",
        "publicationState"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "sourceIds": {
          "$ref": "#/$defs/ids"
        },
        "externalIdentifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "scheme",
              "value",
              "sourceIds"
            ],
            "properties": {
              "scheme": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "sourceIds": {
                "$ref": "#/$defs/ids"
              }
            }
          }
        },
        "publicationState": {
          "const": "accepted"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "sourceId",
        "role",
        "locator"
      ],
      "properties": {
        "sourceId": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "support",
            "qualify",
            "contradict",
            "supersede"
          ]
        },
        "locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "excerpt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "type",
        "label",
        "evidence",
        "sourceIds",
        "period",
        "historical",
        "directional",
        "status",
        "publicationState",
        "claimReview",
        "validity",
        "evidenceEntries"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "$ref": "#/$defs/ids"
        },
        "status": {
          "enum": [
            "documented",
            "acknowledged",
            "finding",
            "conviction",
            "admission",
            "reported",
            "review",
            "allegation",
            "charge",
            "authorized",
            "registered",
            "commitment",
            "audit"
          ]
        },
        "publicationState": {
          "const": "accepted"
        },
        "claimReview": {
          "$ref": "#/$defs/claimReview"
        },
        "validity": {
          "$ref": "#/$defs/validity"
        },
        "evidenceEntries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "historical": {
          "type": "boolean"
        },
        "directional": {
          "type": "boolean"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "title",
        "publisher",
        "url",
        "publicationDate",
        "contentCheck"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "url": {
          "type": "string",
          "pattern": "^https://",
          "format": "uri"
        },
        "sourceFormat": {
          "enum": [
            "archive",
            "original"
          ]
        },
        "publicationDate": {
          "type": "object",
          "required": [
            "value",
            "precision"
          ],
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ]
            },
            "precision": {
              "enum": [
                "day",
                "month",
                "year",
                "unknown"
              ]
            }
          }
        },
        "contentCheck": {
          "type": "object",
          "required": [
            "verified",
            "checkedAt",
            "method",
            "reviewer",
            "sha256"
          ],
          "properties": {
            "verified": {
              "const": true
            },
            "checkedAt": {
              "type": "string"
            },
            "method": {
              "type": "string"
            },
            "reviewer": {
              "$ref": "#/$defs/reviewer"
            },
            "sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "edgeIds",
        "primaryEdgeId",
        "actorIds",
        "sourceIds",
        "date",
        "moneyKind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "edgeIds": {
          "$ref": "#/$defs/ids"
        },
        "actorIds": {
          "$ref": "#/$defs/ids"
        },
        "sourceIds": {
          "$ref": "#/$defs/ids"
        },
        "date": {
          "type": "object",
          "required": [
            "precision",
            "start",
            "end",
            "role"
          ],
          "properties": {
            "precision": {
              "enum": [
                "day",
                "month",
                "year",
                "period",
                "unknown"
              ]
            },
            "start": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "end": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "role": {
              "type": "string"
            }
          },
          "if": {
            "properties": {
              "precision": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "start": {
                "type": "null"
              },
              "end": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              }
            }
          }
        },
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "moneyKind": {
          "type": "string"
        }
      }
    },
    "lead": {
      "type": "object",
      "required": [
        "id",
        "question",
        "entityIds",
        "sourceIds",
        "missingDocument",
        "holder",
        "identifiers",
        "dateRange",
        "status",
        "lastAttempt",
        "resultingRecordIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "entityIds": {
          "$ref": "#/$defs/ids"
        },
        "sourceIds": {
          "$ref": "#/$defs/ids"
        },
        "resultingRecordIds": {
          "$ref": "#/$defs/ids"
        },
        "status": {
          "enum": [
            "open",
            "assigned",
            "attempted",
            "resolved",
            "closed"
          ]
        },
        "lastAttempt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
